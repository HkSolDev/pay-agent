# Copy to .env and fill in real values for your own environment.
# Never commit .env, and never paste real credentials into an AI prompt.
# Every value below is intentionally blank — nothing here is a working default.

# Local Postgres connection string. docker-compose.yml brings up a matching
# local instance; point this at it (or your own Postgres) before running
# `pnpm --dir packages/db exec prisma migrate deploy`.
DATABASE_URL=

# Gmail access, via Composio (https://composio.dev) — the worker reads mail
# through this, never a direct Gmail API key.
COMPOSIO_API_KEY=

# Used for the optional LLM classifier/extractor (see CLASSIFIER_MODE /
# EXTRACTOR_MODE below). Not required if you stay on the deterministic,
# rule-based defaults.
OPENAI_API_KEY=
CLASSIFIER_MODEL=gpt-5-mini
EXTRACTOR_MODEL=gpt-5-mini
LLM_EXTRACTOR_TIMEOUT_MS=10000

# Unset (or anything other than "llm") = free rule-based classifier, safe
# default for everyday local testing. Set to "llm" to use the real, paid
# OpenAI classifier instead — e.g. right before a demo.
CLASSIFIER_MODE=
EXTRACTOR_MODE=

# Payee payment methods (VPA/bank details) are encrypted at rest, never
# stored as plaintext. Generate a real 32-byte key per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYEE_HASH_KEY is optional — falls back to PAYEE_ENCRYPTION_KEY if unset,
# but a separate key is better: compromising one shouldn't hand over both.
PAYEE_ENCRYPTION_KEY=
PAYEE_HASH_KEY=

# "perflo" alone only works if installed globally. Confirmed working without
# that: the npx form below. Perflo payment execution is wired but inert
# until Perflo KYC/account access clears — see the Architecture section of
# README.md for how the payment executor is chosen.
PERFLO_CLI_PATH=npx @perflo/cli@latest

# RazorpayX sandbox/test-mode keys only (from the "Test Mode" dashboard) —
# never live/production keys in this repo. Used by the pluggable
# PaymentExecutor (worker/src/payment-executor-razorpay.ts) as an
# alternative to Perflo; unset means the Perflo executor stays the default.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The RazorpayX business account/customer-identifier being debited (from the
# dashboard: My Account & Settings -> Banking -> Customer Identifier).
# Required by the real Payouts API as `account_number`; distinct per test
# mode vs live mode.
RAZORPAY_ACCOUNT_NUMBER=

APP_URL=http://localhost:3000

# How often the worker polls Gmail for new mail, in seconds. Lower this for
# testing if you want to watch mail arrive live.
POLL_INTERVAL_SECONDS=300

# Deployment-wide kill switch for automatic payment execution. Unset (or
# anything other than "on") = every payment still requires an explicit
# owner click, no matter what else is true. This is one of TWO switches
# that both must be on — the other is the per-payee "auto-pay enabled"
# toggle on the Payees page — for any payment to ever execute without a
# click. See worker/src/policy-engine.ts and worker/src/auto-pay-gate.ts.
# Keep this blank/off during setup. Set to "on" only for a deliberate
# demonstration once you understand exactly what it does.
AUTO_PAY_MODE=

# Demo-only: allow an invoice sender to match an already-registered payment
# rail, regardless of who actually sent it. Keep unset/false in a real
# deployment — this relaxes sender-identity verification, not just a demo
# convenience. Does not by itself enable auto-pay.
DEMO_MODE=

# Optional extra ceiling on top of each payee's own per-payment cap,
# applied only to auto-pay (manual "Confirm & pay" is unaffected). Unset =
# no extra ceiling beyond each payee's own grant. A conservative starting
# value is recommended before ever setting AUTO_PAY_MODE=on for real.
AUTO_PAY_MAX_AMOUNT_INR=

# Minimal host-level password gate for a public deployment (app/middleware.ts,
# if present). Both must be set for the gate to activate; unset disables it
# entirely. There is no other login/auth in this app — see README.md.
DEMO_BASIC_AUTH_USER=
DEMO_BASIC_AUTH_PASSWORD=
