{"nodes": [{"id": "perflo_docs_concepts__how_perflo_works_page", "label": "How Perflo works", "file_type": "document", "source_file": "perflo_docs/concepts__how-perflo-works.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "perflo_docs_concepts__how_perflo_works_self_custody", "label": "Self-custodial smart account", "file_type": "concept", "source_file": "perflo_docs/concepts__how-perflo-works.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perflo does not hold assets in an omnibus company wallet and cannot move money by itself, so balances are verifiable on public block explorers."}, {"id": "perflo_docs_concepts__how_perflo_works_sessions", "label": "Session permissions", "file_type": "concept", "source_file": "perflo_docs/concepts__how-perflo-works.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Withdrawals to external addresses always require a fresh confirmation and no session can raise its own limits, so money can never leave the account without the customer."}, {"id": "perflo_docs_concepts__how_perflo_works_public_venues", "label": "Public venue routing", "file_type": "concept", "source_file": "perflo_docs/concepts__how-perflo-works.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perflo runs no exchange and never takes the other side of a trade, so prices, rates and liquidity come from the public venues and are passed through."}], "edges": [{"source": "perflo_docs_concepts__how_perflo_works_page", "target": "perflo_docs_concepts__how_perflo_works_self_custody", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "perflo_docs/concepts__how-perflo-works.md", "source_location": null, "weight": 1.0}, {"source": "perflo_d