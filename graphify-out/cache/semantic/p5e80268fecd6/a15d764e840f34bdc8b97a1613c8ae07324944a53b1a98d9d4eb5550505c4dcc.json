_ap_agent_v0", "target": "prd_perflo_ap_agent_v0_test_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 1.0}, {"source": "prd_perflo_ap_agent_v0_ingest_worker", "target": "prd_perflo_ap_agent_v0_gmail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 0.95}, {"source": "prd_perflo_ap_agent_v0_ingest_worker", "target": "prd_perflo_ap_agent_v0_composio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 1.0}, {"source": "prd_perflo_ap_agent_v0_ingest_worker", "target": "prd_perflo_ap_agent_v0_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 0.95}, {"source": "prd_perflo_ap_agent_v0_queue_ui", "target": "prd_perflo_ap_agent_v0_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 0.95}, {"source": "prd_perflo_ap_agent_v0_reconciler", "target": "prd_perflo_ap_agent_v0_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 0.9}, {"source": "prd_perflo_ap_agent_v0_payment_executor", "target": "prd_perflo_ap_agent_v0_perflo_cli", "relation": "calls", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_location": null, "weight": 0.9}, {"source": "prd_perflo_ap_agent_v0_reconciler", "target": "prd_perflo_ap_agent_v0_perflo_cli", "relation": "calls", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PRD_PERFLO_AP_AGENT_V0.md", "source_locatio