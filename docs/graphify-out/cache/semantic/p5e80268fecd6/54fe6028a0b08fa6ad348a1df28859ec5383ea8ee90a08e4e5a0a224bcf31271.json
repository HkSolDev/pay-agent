{"nodes": [{"id": "architecture_and_pipeline_spec", "label": "Architecture & Pipeline Master Specification", "file_type": "document", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_golden_rule", "label": "Golden Rule: Deterministic Money, Sandboxed LLM", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable invariant: the LLM never touches money (classifier and extractor have zero tools, verifier has only read-only x402 tools); payment logic is deterministic TypeScript + PostgreSQL row locks; Perflo browser-approved guardrails are the gate for all money movement."}, {"id": "architecture_and_pipeline_spec_gmail_inbox", "label": "Gmail Inbox", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_composio", "label": "Composio (Gmail Connector / Cron)", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_ingest_worker", "label": "Ingest Worker", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_postgresql", "label": "PostgreSQL Database", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_classifier", "label": "Classifier (Fast LLM, No Tools)", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheap deterministic code filter runs before the LLM to drop newsletters, calendar invites, and automated receipts without model spend; untrusted body text is wrapped in delimiters to neutralize prompt injections."}, {"id": "architecture_and_pipeline_spec_extractor", "label": "Extractor (LLM, Strict JSON)", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces a strict JSON output schema with per-field confidence; ambiguous amounts are forced to low confidence so they require manual approval instead of auto-payment."}, {"id": "architecture_and_pipeline_spec_payee_resolver", "label": "Payee Resolver", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_verifier_engine", "label": "Verifier Engine", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_policy_engine", "label": "Policy Engine", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure deterministic code gate: auto-pay occurs only when all conditions (confidence, exact hash match, auth pass, score, caps, not paused) hold \u2014 no LLM judgement in the pay decision."}, {"id": "architecture_and_pipeline_spec_payment_executor", "label": "Payment Executor", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-writer design via SELECT ... FOR UPDATE SKIP LOCKED and per-recipient in-flight serialization prevents double payment under concurrency; idempotency key derived from message/amount/recipient makes replays no-ops."}, {"id": "architecture_and_pipeline_spec_reconciler", "label": "Reconciler", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_perflo_cli", "label": "Perflo CLI (@perflo/cli@latest)", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_perflo_vault", "label": "Perflo Vault & Banking Rails", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "architecture_and_pipeline_spec_x402_tools", "label": "x402 Marketplace Tools", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paid verifications (verify_email, browse_web) are the only LLM-adjacent spend and are strictly read-only; invoice links opened inside Perflo's isolated headless browser."}, {"id": "architecture_and_pipeline_spec_verify_email", "label": "verify_email x402 Tool", "file_type": "concept", "source_file": "ARCHITECTURE_AND_PIPELINE_SPEC.md", "