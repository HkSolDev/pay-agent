{"nodes": [{"id": "perflo_docs_developers__concepts__authentication_page", "label": "Authentication and token lifecycle", "file_type": "document", "source_file": "perflo_docs/developers__concepts__authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "perflo_docs_developers__concepts__authentication_customer_token", "label": "Customer Perflo token (EdDSA accessJwt)", "file_type": "concept", "source_file": "perflo_docs/developers__concepts__authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token is financial authority over the customer's Perflo account, so it must be kept in a server-side session; browser exposure would let an XSS vulnerability act as the customer."}, {"id": "perflo_docs_developers__concepts__authentication_agent_token", "label": "Agent pfa_ pairing token", "file_type": "concept", "source_file": "perflo_docs/developers__concepts__authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revocation or mandate expiry is what ends a copied token's authority, so the mandate's own limits are what a leaked token can actually spend."}, {"id": "perflo_docs_developers__concepts__authentication_gateway_device", "label": "Gateway device credential", "file_type": "concept", "source_file": "perflo_docs/developers__concepts__authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work on the customer's account runs through a separate encrypted device credential so the customer token is never copied into the stored gateway credential slot; the API never returns it."}, {"id": "perflo_docs_developers__concepts__authentication_webhook_signing_secret", "label": "Webhook HMAC signing secret", "file_type": "concept", "source_file"