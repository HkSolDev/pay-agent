// Prisma 7: the connection URL lives in prisma.config.ts now, not here —
// this schema only declares the SQL dialect and where the client gets generated.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Phase 0: only the `emails` table. Everything else (payees, grants, payment_intents)
// waits until domain-modeling has been run on those terms — see CONTEXT.md.
model Email {
  id           String   @id @default(cuid())

  // The one uniqueness constraint that makes Ingest safe to run on a loop (FR-2):
  // re-polling never creates a second row for a message we've already seen.
  gmailMessageId String @unique @map("gmail_message_id")
  gmailThreadId  String @map("gmail_thread_id")

  fromAddr   String  @map("from_addr")
  fromName   String? @map("from_name")
  replyTo    String? @map("reply_to")
  returnPath String? @map("return_path")
  toAddrs    String[] @map("to_addrs")

  date    DateTime
  subject String?
  snippet String?

  rawHeaders   Json    @map("raw_headers")
  bodyText     String? @map("body_text")
  bodyHtmlHash String? @map("body_html_hash")
  attachments  Json?
  links        Json?

  // SPF/DKIM/DMARC — read at Verify time (Section 8.2), captured now while we have the headers.
  auth Json?

  senderPriorCount Int       @default(0) @map("sender_prior_count")
  senderFirstSeen  DateTime? @map("sender_first_seen")
  inOwnerThread    Boolean   @default(false) @map("in_owner_thread")

  // Level 1 triage result. The cheap Level 0 junk pass remains `ignored`;
  // every other message receives the classifier's kind, confidence and
  // evidence before it enters the queue.
  classification           String?
  classificationConfidence Float?  @map("classification_confidence")
  classificationRationale  String? @map("classification_rationale")
  injectionDetected        Boolean @default(false) @map("injection_detected")
  injectionEvidence        Json?   @map("injection_evidence")

  // Level 1's persistent, reviewable decision trail. `extractionSummary`
  // intentionally excludes raw UPI/account details. The original email body
  // is retained separately as the audit source; derived rail values remain
  // transient or live only in encrypted PayeePaymentMethod rows.
  extractionSummary Json?    @map("extraction_summary")
  extractionBackend String?  @map("extraction_backend")
  resolvedPayeeId String?    @map("resolved_payee_id")
  payeeResolution Json?      @map("payee_resolution")
  verificationResult Json?   @map("verification_result")
  duplicateResult Json?      @map("duplicate_result")
  policyDecision String?     @map("policy_decision")
  policyReasons String[]     @default([]) @map("policy_reasons")
  level1ProcessedAt DateTime? @map("level1_processed_at")
  reviewStatus String? @map("review_status")
  reviewedAt DateTime? @map("reviewed_at")

  gmailLabels String[] @map("gmail_labels")
  ingestedAt  DateTime @default(now()) @map("ingested_at")

  @@map("emails")
}

// Single-row table (id is always 1): the worker's "since" pointer, durable
// across restarts. Without this, killing the worker process (which happens
// constantly during dev) silently drops mail that arrived in the gap between
// the last successful poll and the restart — `after:now()` on startup skips
// straight past it.
model IngestCheckpoint {
  id                Int      @id @default(1)
  sinceEpochSeconds Int      @map("since_epoch_seconds")
  // Owner-controlled kill switch for background Gmail polling (the "Paused"
  // button) — the worker's poll loop checks this before every fetch. Lives
  // on this single-row table rather than a new one since it's the same
  // "where sync currently stands" concept the checkpoint already tracks.
  paused            Boolean  @default(false)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ingest_checkpoint")
}

// A real enum, not a plain string: three real bugs already happened in this
// project's history from status being untyped (a WHERE clause silently only
// covering 2 of 5 states, a switch missing a branch). Postgres itself now
// rejects an invalid value, and TypeScript can force every consumer to
// handle every case — see worker/src/payment-status.ts's exhaustive check.
enum PaymentIntentStatus {
  pending
  claimed
  paid
  failed
  unknown_outcome
}

// Level 0's "locked manual pay": the owner types a recipient nickname and
// amount once (prepare), then a separate explicit click (confirm) actually
// pays. One intent per email — a real payee/grant/idempotency-key system
// (FR-16, FR-23) waits for domain-modeling; this is deliberately the small
// version that makes "never pay twice" true today, not the full one yet.
model PaymentIntent {
  id     String @id @default(cuid())
  emailId String @unique @map("email_id")

  recipientNickname String @map("recipient_nickname")
  amount            String
  currency          String @default("INR")

  // Set once, at prepare time — never regenerated, so a retry after a crash
  // reuses the same key instead of minting a new one (same principle FR-23
  // uses: the key identifies the logical payment, not the attempt).
  idempotencyKey String @unique @map("idempotency_key")

  // pending -> claimed (row-locked, in progress) -> paid | failed | unknown_outcome
  // failed -> claimed again (owner retry). unknown_outcome never transitions
  // automatically (FR-27) — only a human, after checking `perflo activity`.
  status PaymentIntentStatus @default(pending)

  paymentReference String?   @map("payment_reference")
  // The actual reason the last attempt didn't reach "paid" — e.g. "Not
  // connected. Run `perflo login` first." Without this the owner only ever
  // sees a generic "Failed," which hides exactly the NOT_CONNECTED/NO_SESSION
  // cases the PRD says should be surfaced clearly, not lumped in with an
  // ordinary rejection.
  lastError String?   @map("last_error")
  claimedAt DateTime? @map("claimed_at")
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("payment_intents")
}

// FR-15: a payee is an identity+payment-method pair, and the mapping only
// ever exists because the owner approved it — nothing here is ever
// auto-inferred by the resolver. One payee can have several approved email
// identities (FR-18, "this new email is also Riya") without duplicating
// Riya as a second payee, which a single flat table couldn't express.
model Payee {
  id                String  @id @default(cuid())
  name              String
  recipientNickname String  @map("recipient_nickname") // the Perflo nickname this payee pays through
  // Only true once the real Perflo grant (perflo grant enable, Section 7.7's
  // browser approval) has actually been set up — a Payee row existing on
  // its own is NOT the same as being allowed to auto-pay (FR-18: the grant
  // approval IS the new-payee approval, nothing less counts).
  grantApproved Boolean @default(false) @map("grant_approved")
  // "pending" | "pending_grant" | "approved" | "revoked" — not a Prisma enum: this mirrors
  // PayeePaymentMethod.status below, kept as a plain string for the same
  // reason (owner-facing lifecycle labels, not a closed set worth an enum
  // migration every time a new one is added).
  status String @default("pending") @map("status")

  // A raw-SQL partial unique index (migration 20260904142701) enforces
  // "at most one row has status = 'pending_grant'" at the database level —
  // not expressible here in schema.prisma, so it won't show up on this
  // model. See that migration's own comment before touching this table's
  // indexes.
  pendingGrantStartedAt   DateTime? @map("pending_grant_started_at")
  pendingGrantExpiresAt   DateTime? @map("pending_grant_expires_at")
  lastGrantOutcome        String?   @map("last_grant_outcome") // "expired" | "denied", cleared once a new attempt starts
  pendingGrantApprovalUrl String?   @map("pending_grant_approval_url")

  // The grant caps/expiry approvePayee already validates (GrantRequest) but,
  // until now, had nowhere real to persist — see worker/src/payee-approval.ts.
  grantPerPaymentCapInr String?   @map("grant_per_payment_cap_inr")
  grantTotalCapInr      String?   @map("grant_total_cap_inr")
  grantMaxPayments      Int?      @map("grant_max_payments")
  grantExpiresAt        DateTime? @map("grant_expires_at")

  // Per-payee opt-in for FR-18/FR-19's `auto_pay` decision to actually
  // execute (see worker/src/auto-pay-gate.ts). Off by default: approving a
  // payee only ever grants a rail to pay *through* (see payee-actions.ts),
  // never a standing instruction to pay automatically — that's this
  // separate, deliberate switch. Also gated globally by AUTO_PAY_MODE, so
  // turning this on for one payee alone still does nothing unless the owner
  // has also enabled auto-pay for the whole deployment.
  autoPayEnabled Boolean @default(false) @map("auto_pay_enabled")

  createdAt  DateTime  @default(now()) @map("created_at")
  approvedAt DateTime? @map("approved_at")
  revokedAt  DateTime? @map("revoked_at")

  identities     PayeeIdentity[]
  paymentMethods PayeePaymentMethod[]

  @@map("payees")
}

model PayeeIdentity {
  id         String   @id @default(cuid())
  payeeId    String   @map("payee_id")
  payee      Payee    @relation(fields: [payeeId], references: [id])
  senderAddr String   @unique @map("sender_addr") // one address belongs to exactly one payee
  approvedAt DateTime @default(now()) @map("approved_at")

  @@map("payee_identities")
}

// Raw bank/UPI identifiers are never stored as plaintext. `encryptedPayload`
// holds the actual normalized method (AES-256-GCM, worker/src/payee-crypto.ts),
// and `lookupHash` is a separate keyed hash (HMAC-SHA256, same module) used
// for the resolver's exact-match lookup — DB access alone can't be
// brute-forced back into a real VPA or account number from the hash.
model PayeePaymentMethod {
  id               String   @id @default(cuid())
  payeeId          String   @map("payee_id")
  payee            Payee    @relation(fields: [payeeId], references: [id])
  rail             String   // "upi" | "bank_neft"
  encryptedPayload Bytes    @map("encrypted_payload")
  lookupHash       String   @unique @map("lookup_hash")

  // "active" | "replaced" | "revoked". Only "active" rails are ever loaded
  // by loadApprovedPayees (payee-store.ts) — replacing or revoking a rail
  // never deletes the row, so the full created/approved/replaced/revoked
  // history stays queryable per payee.
  status     String    @default("active") @map("status")
  createdAt  DateTime  @default(now()) @map("created_at")
  approvedAt DateTime  @default(now()) @map("approved_at")
  replacedAt DateTime? @map("replaced_at")
  revokedAt  DateTime? @map("revoked_at")

  // Points at the new row created when this one was replaced — self-relation
  // kept nullable and unindexed-by-FK (a plain id column) so replacing a rail
  // is a two-step "create new, then stamp old" write, not a single row that
  // has to reference a not-yet-existing id.
  replacedByMethodId String? @map("replaced_by_method_id")

  @@map("payee_payment_methods")
}
